# ---------------------------------------------------------------- required in production
# Random string, at least 32 characters. Generate one with:  openssl rand -base64 48
SESSION_SECRET=

# PostgreSQL connection string. Leave empty locally to use the built-in embedded database.
DATABASE_URL=
# Run migrations automatically when the server starts (recommended for single-instance deploys).
AUTO_MIGRATE=false

# ---------------------------------------------------------------- first admin (used by `npm run db:seed`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-password
ADMIN_NAME=Administrator

# ---------------------------------------------------------------- optional
# Embedded database folder (only when DATABASE_URL is empty).
PGLITE_DIR=.data/pglite
# Set to "closed" to stop teachers from signing up themselves.
TEACHER_SIGNUP=open
# Extra hostnames allowed to send write requests (comma separated), e.g. a custom domain behind a proxy.
ALLOWED_ORIGINS=

# Uploaded media: stored in UPLOAD_DIR unless an S3-compatible bucket (e.g. Cloudflare R2) is configured.
UPLOAD_DIR=.data/uploads
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket, e.g. https://media.example.org (also added to the CSP).
MEDIA_PUBLIC_ORIGIN=
